// 免绑卡版（由 scripts/lite-config.mjs 自动生成）：不使用 R2，邮件正文存 D1，大附件存 KV
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-mailbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-mailbox",
      "migrations_dir": "migrations"
    },
    {
      "binding": "BLOBS",
      "database_name": "cf-mailbox-blobs"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "WORKER_NAME": "cf-mailbox"
  },
  // 每分钟：定时发送、稍后提醒、投递状态；每天 03:17（UTC）：清理废纸篓与过期附件
  "triggers": { "crons": ["* * * * *", "17 3 * * *"] },
  // Workers AI：会话摘要、翻译、起草回复、可选的垃圾邮件判定
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
